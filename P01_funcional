sum :: [Int] -> Int
sum = foldr (+) 0

elem :: Eq a => a -> [a] -> Bool
elem y = foldr (\y acc -> y==acc || acc ) False xs

(++) :: [a] -> [a] -> [a]
(++) = foldr (\x h xs -> x : h  xs) id

mapFoldr :: (a->b) ->[a] -> [b]
mapFoldr f = foldr (\x xs -> f x : xs) []

filterFoldr :: (a -> Bool) -> [a] -> [a]
filterFoldr p = folder (\x xs -> if p x then x:xs else xs) []

